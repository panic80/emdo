# Non-secret deployment settings only. Copy this outside the checkout and use
# exact image references in the form registry/name@sha256:<64 lowercase hex>.
# Placeholder values below are intentionally invalid and are rejected by the
# deployment scripts.
SOURCE_SHA=REPLACE_WITH_40_HEX_GIT_SHA
API_IMAGE=ghcr.io/panic80/emdo-api@sha256:REPLACE_WITH_64_HEX_DIGEST
WORKER_IMAGE=ghcr.io/panic80/emdo-worker@sha256:REPLACE_WITH_64_HEX_DIGEST
WEB_IMAGE=ghcr.io/panic80/emdo-web@sha256:REPLACE_WITH_64_HEX_DIGEST
POSTGRES_IMAGE=pgvector/pgvector@sha256:REPLACE_WITH_64_HEX_DIGEST
POWERSYNC_IMAGE=journeyapps/powersync-service@sha256:REPLACE_WITH_64_HEX_DIGEST
CADDY_IMAGE=caddy@sha256:REPLACE_WITH_64_HEX_DIGEST

# Production host settings. Keep the referenced directory mode 0700 and every
# contained secret or env file mode 0600.
COMPOSE_PROJECT_NAME=emdo-production
DEPLOYMENT_NAMESPACE=production
EMDO_ENVIRONMENT=production
EMDO_DOMAIN=assistant.example.ca
ACME_EMAIL=operations@example.ca
POWERSYNC_JWKS_URI=https://assistant.example.ca/.well-known/jwks.json
SECRETS_DIR=/etc/emdo/production

# Staging uses a different directory and fixed loopback ports. The workflow
# admits only one staging run at a time and never opens these ports publicly.
STAGING_RUN_ID=REPLACE_WITH_GITHUB_RUN_ID
STAGING_HTTP_PORT=18080

# Required files beneath SECRETS_DIR (never commit them):
# postgres_superuser_password, api_database_password,
# auth_database_password, onboarding_database_password, worker_database_password,
# worker_executor_database_password, worker_dispatcher_database_password,
# audio_reconciliation_database_password, finance_import_retention_database_password,
# google_oauth_disconnect_reconciliation_database_password,
# workflow_database_password,
# visual_decision_database_password,
# powersync_replication_password, powersync_storage_password, migration.env,
# owner_bootstrap_database_password, api.env, edge-proxy.env, worker.env,
# finance-import-retention.env, google-oauth-disconnect-reconciliation.env,
# powersync.env.
# Staging additionally requires synthetic.env (HTTP-only fixture identity) and
# synthetic-bootstrap.env (owner-bootstrap DSN and one-time household fields).

[Unit]
Description=Fail on unsafe EMDO logical-replication or Docker disk pressure
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/sbin/emdo-dispatch-active-release check-replication-pressure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/emdo /etc/emdo

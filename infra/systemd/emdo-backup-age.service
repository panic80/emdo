[Unit]
Description=Fail when the newest complete EMDO logical backup is stale
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/sbin/emdo-dispatch-active-release check-backup-age
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/backups/emdo /var/lib/emdo /etc/emdo

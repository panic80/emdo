**

!.dockerignore
!Dockerfile
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.base.json
!.npmrc

!apps/
!apps/*/
!apps/*/package.json
!apps/*/src/
!apps/*/src/**
!apps/*/tsconfig*.json
!apps/*/build.mjs
!apps/web/index.html
!apps/web/public/
!apps/web/public/**
!apps/web/scripts/
!apps/web/scripts/assert-release-artifact.mjs
!apps/web/scripts/copy-powersync-static-assets.mjs
!apps/web/vite.config.ts

!packages/
!packages/*/
!packages/*/package.json
!packages/*/src/
!packages/*/src/**
!packages/*/tsconfig*.json
!packages/agents/
!packages/agents/*/
!packages/agents/*/package.json
!packages/agents/*/src/
!packages/agents/*/src/**
!packages/agents/*/tsconfig*.json
!packages/agent-core/smoke/
!packages/agent-core/smoke/clean-dist.mjs
!packages/db/deployment/
!packages/db/deployment/**
!packages/db/drizzle.config.ts
!packages/db/drizzle/
!packages/db/drizzle/**

!infra/
!infra/compose/
!infra/compose/web.nginx.conf
!infra/scripts/
!infra/scripts/prune-deployed-workspace.mjs
!infra/scripts/validate-runtime-package.mjs

# Re-apply sensitive/noise exclusions after every broad source allowlist.
**/.env*
**/.git
**/.git/**
**/node_modules
**/node_modules/**
**/dist
**/dist/**
apps/web/public/@powersync
apps/web/public/@powersync/**
**/src/test
**/src/test/**
**/*.test.*
**/*.spec.*

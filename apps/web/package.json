{
  "name": "@emdo/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/copy-powersync-static-assets.mjs && tsc --project tsconfig.json --noEmit && vite build && node scripts/assert-release-artifact.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "pnpm run test:e2e:dev && pnpm run test:e2e:production",
    "test:e2e:dev": "playwright test --config playwright.config.ts",
    "test:e2e:production": "playwright test --config playwright.production.config.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "1.6.26",
    "@better-auth/core": "1.6.26",
    "@better-auth/utils": "0.4.2",
    "@better-fetch/fetch": "1.3.1",
    "@emdo/contracts": "workspace:*",
    "@emdo/domains": "workspace:*",
    "@hookform/resolvers": "5.7.1",
    "@powersync/web": "2.1.1",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.25",
    "better-auth": "1.6.26",
    "better-call": "1.3.7",
    "jose": "6.2.8",
    "kysely": "0.29.4",
    "nanostores": "1.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "workbox-precaching": "7.4.1",
    "workbox-window": "7.4.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "29.0.1",
    "playwright-core": "1.62.1",
    "vite": "8.2.1",
    "vite-plugin-pwa": "1.3.0"
  }
}

# Copy to .env.local for local development. Never commit credentials.
DATABASE_URL=postgresql://emdo:emdo@localhost:5432/emdo
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:3000

# Optional production voice configuration is API-only and all-or-nothing.
# Keep real credentials outside the checkout; see docs/deployment/secrets.md.
# EMDO_OPENAI_AUDIO_API_KEY=REPLACE_WITH_OPENAI_AUDIO_KEY
# EMDO_OPENAI_SPEECH_MODEL=tts-1
# EMDO_OPENAI_AUDIO_PRICING_B64URL=REPLACE_WITH_VERSIONED_BASE64URL_JSON
